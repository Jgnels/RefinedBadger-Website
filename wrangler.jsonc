{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "refinedbadger-site",
  "compatibility_date": "2026-09-03",
  "main": "./src/worker.mjs",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
